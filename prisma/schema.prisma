// Bottega Digitale — Full Multi-Tenant Schema
// SQLite database via Prisma ORM

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Auth & Multi-Tenancy ───────────────────────────────────────

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  passwordHash   String
  role           String       @default("owner") // owner | staff
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  memberships    Membership[]
  sessions       Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Business {
  id                     String         @id @default(cuid())
  name                   String
  slug                   String         @unique
  category               String
  city                   String         @default("Forlì")
  address                String
  phone                  String
  email                  String
  description            String
  openingHours           String         @default("[]") // JSON array
  websiteVisitsThisMonth Int            @default(0)
  bookingLeadTime        String         @default("24 ore")
  // Subscription
  subscriptionTier       String         @default("vetrina") // vetrina | bottega | maestro
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  // Website publishing
  websitePublished       Boolean        @default(false)
  customDomain           String?
  websiteTemplate        String         @default("default")
  // Google Business Profile
  googlePlaceId          String?
  googleAccessToken      String?
  googleRefreshToken     String?
  // WhatsApp
  whatsappPhoneId        String?
  whatsappToken          String?
  // Queue management
  queueEnabled           Boolean        @default(false)
  avgServiceMinutes      Int            @default(30)
  // Loyalty
  loyaltyEnabled         Boolean        @default(false)
  loyaltyPointsPerVisit  Int            @default(10)
  loyaltyRewardThreshold Int            @default(100)
  loyaltyRewardName      String         @default("Servizio gratuito")
  // Online booking
  onlineBookingEnabled   Boolean        @default(false)
  maxDailyBookings       Int            @default(20)
  bookingBufferMinutes   Int            @default(10)
  // Cross-promotion
  crossPromoEnabled      Boolean        @default(false)
  // Fiscal
  partitaIva             String?
  codiceFiscale          String?
  codiceDestinatarioSdi  String?        @default("0000000")
  regimeFiscale          String?        @default("RF01")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  memberships            Membership[]
  services               Service[]
  bookings               Booking[]
  customers              Customer[]
  reviews                Review[]
  socialPosts            SocialPost[]
  queueEntries           QueueEntry[]
  loyaltyCards           LoyaltyCard[]
  loyaltyRedemptions     LoyaltyRedemption[]
  whatsappMessages       WhatsappMessage[]
  automationFlows        AutomationFlow[]
  jobs                   Job[]
  insights               Insight[]
  staffProfiles          StaffProfile[]
  fiscalProfile          FiscalProfile?
  partnershipsInitiated  Partnership[]  @relation("PartnerA")
  partnershipsReceived   Partnership[]  @relation("PartnerB")
  crossPromotionsSent    CrossPromotion[] @relation("PromoFrom")
  crossPromotionsReceived CrossPromotion[] @relation("PromoTo")
  vouchers               Voucher[]
  pushSubscriptions      PushSubscription[]
  // Iter3: WhatsApp AI
  whatsappAiEnabled      Boolean        @default(false)
  whatsappAiPersonality  String         @default("amichevole") // formale | amichevole
  whatsappAiFaqs         String         @default("[]") // JSON array of {q,a}
  // Iter3: Product Catalog
  catalogEnabled         Boolean        @default(false)
  products               Product[]
  productCategories      ProductCategory[]
  orders                 Order[]
  // Iter3: Payments
  stripeConnectAccountId String?
  depositPercentage      Int            @default(30)
  depositsEnabled        Boolean        @default(false)
  // Iter3: Notifications
  notifications          Notification[]
  // Iter3: Association
  associationMemberships AssociationMembership[]
  // Iter3: Accountant
  accountantLinks        AccountantClientLink[]
  // Iter3: i18n
  locale                 String         @default("it")
  // Iter3: Marketplace
  giftCards              GiftCard[]
  // Iter3: Platform Analytics
  platformEvents         PlatformEvent[]
  healthScore            BusinessHealthScore?
  // Iter4
  mediaAssets            MediaAsset[]
  apiKeys                ApiKey[]
  webhookEndpoints       WebhookEndpoint[]
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  role       String   @default("owner") // owner | staff
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
}

// ─── Services ───────────────────────────────────────────────────

model Service {
  id             String    @id @default(cuid())
  businessId     String
  name           String
  priceEuro      Float
  durationMinutes Int
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  createdAt      DateTime  @default(now())
}

// ─── Bookings ───────────────────────────────────────────────────

model Booking {
  id              String   @id @default(cuid())
  businessId      String
  customerId      String?
  serviceId       String?
  staffId         String?
  customerName    String
  customerPhone   String?
  service         String   // denormalized service name
  startsAt        DateTime
  durationMinutes Int      @default(30)
  status          String   @default("Confermata") // Confermata | In attesa | Completata | Cancellata
  channel         String   @default("Sito web") // Sito web | WhatsApp | Instagram | Telefono | Online
  priceEuro       Float    @default(0)
  notes           String?
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerRef     Customer? @relation(fields: [customerId], references: [id])
  serviceRef      Service?  @relation(fields: [serviceId], references: [id])
  staffProfile    StaffProfile? @relation(fields: [staffId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Customers & CRM ────────────────────────────────────────────

model Customer {
  id            String         @id @default(cuid())
  businessId    String
  name          String
  phone         String
  email         String?
  birthday      DateTime?
  lastVisit     DateTime
  lastLogin     DateTime?
  totalVisits   Int            @default(1)
  loyaltyPoints Int            @default(0)
  notifyWhatsApp Boolean       @default(true)
  notifyPush    Boolean        @default(true)
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  loyaltyCards  LoyaltyCard[]
  queueEntries  QueueEntry[]
  customerSessions CustomerSession[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ─── Reviews ────────────────────────────────────────────────────

model Review {
  id                 String   @id @default(cuid())
  businessId         String
  author             String
  rating             Int
  date               DateTime
  comment            String
  responseSuggestion String?
  responded          Boolean  @default(false)
  googleReviewId     String?
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
}

// ─── Stripe / Billing ───────────────────────────────────────────

model StripeEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  data          String   // JSON
  processedAt   DateTime @default(now())
}

// ─── WhatsApp Messages ──────────────────────────────────────────

model WhatsappMessage {
  id         String   @id @default(cuid())
  businessId String
  direction  String   // inbound | outbound
  phone      String
  body       String
  status     String   @default("sent") // sent | delivered | read | failed
  templateId String?
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// ─── AI Social Media Content ────────────────────────────────────

model SocialPost {
  id          String   @id @default(cuid())
  businessId  String
  imageUrl    String?
  caption     String
  hashtags    String   @default("") // comma-separated
  platform    String   @default("instagram") // instagram | facebook
  status      String   @default("draft") // draft | scheduled | published
  scheduledAt DateTime?
  publishedAt DateTime?
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Walk-In Queue ──────────────────────────────────────────────

model QueueEntry {
  id              String   @id @default(cuid())
  businessId      String
  customerId      String?
  customerName    String
  customerPhone   String?
  position        Int
  status          String   @default("waiting") // waiting | called | serving | completed | cancelled
  estimatedWaitMin Int     @default(0)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customerId], references: [id])
  createdAt       DateTime @default(now())
  calledAt        DateTime?
  completedAt     DateTime?
}

// ─── Digital Loyalty Card ───────────────────────────────────────

model LoyaltyCard {
  id          String              @id @default(cuid())
  businessId  String
  customerId  String
  points      Int                 @default(0)
  totalEarned Int                 @default(0)
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  redemptions LoyaltyRedemption[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([businessId, customerId])
}

model LoyaltyRedemption {
  id         String      @id @default(cuid())
  businessId String
  cardId     String
  points     Int
  reward     String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  card       LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
}

// ─── Automation Engine (Feature 1) ──────────────────────────────

model AutomationFlow {
  id          String          @id @default(cuid())
  businessId  String
  name        String
  description String?
  enabled     Boolean         @default(true)
  triggerEvent String         // booking.completed | booking.created | customer.created | review.received | loyalty.threshold_reached | queue.turn_approaching
  conditions  String          @default("{}") // JSON conditions
  actions     String          @default("[]") // JSON array of action configs
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  executions  FlowExecution[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model FlowExecution {
  id          String         @id @default(cuid())
  flowId      String
  triggerData String         @default("{}") // JSON
  status      String         @default("pending") // pending | running | completed | failed
  results     String         @default("[]") // JSON array of action results
  error       String?
  flow        AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  startedAt   DateTime       @default(now())
  completedAt DateTime?
}

// ─── Background Job Scheduler (Feature 2) ───────────────────────

model Job {
  id           String    @id @default(cuid())
  businessId   String?
  type         String    // booking-reminder | google-review-sync | social-publisher | loyalty-birthday | subscription-warning | insight-generator
  status       String    @default("pending") // pending | running | completed | failed | cancelled
  priority     Int       @default(0)
  payload      String    @default("{}") // JSON
  result       String?   // JSON
  error        String?
  scheduledAt  DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  retryCount   Int       @default(0)
  maxRetries   Int       @default(3)
  cronExpression String? // for recurring jobs
  nextRunAt    DateTime?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── AI Advisor / Insights (Feature 4) ──────────────────────────

model Insight {
  id          String   @id @default(cuid())
  businessId  String
  category    String   // revenue | schedule | retention | reputation | benchmark
  title       String
  body        String
  actionLabel String?
  dismissed   Boolean  @default(false)
  deliveredVia String  @default("dashboard") // dashboard | whatsapp | both
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// ─── Multi-Staff (Feature 5) ────────────────────────────────────

model StaffProfile {
  id            String    @id @default(cuid())
  businessId    String
  userId        String?
  name          String
  email         String?
  phone         String?
  role          String    @default("staff") // owner | manager | staff
  color         String    @default("#3B82F6") // calendar color
  workingHours  String    @default("[]") // JSON array of day schedules
  serviceIds    String    @default("[]") // JSON array of service IDs they can perform
  active        Boolean   @default(true)
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Customer Self-Service Portal (Feature 6) ───────────────────

model CustomerSession {
  id          String   @id @default(cuid())
  customerId  String
  token       String   @unique
  otpCode     String?
  otpExpiresAt DateTime?
  verified    Boolean  @default(false)
  expiresAt   DateTime
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// ─── E-Invoice / Fatturazione Elettronica (Feature 7) ───────────

model FiscalProfile {
  id                   String   @id @default(cuid())
  businessId           String   @unique
  ragioneSociale       String
  partitaIva           String
  codiceFiscale        String
  indirizzo            String
  cap                  String
  citta                String
  provincia            String   @default("FC")
  nazione              String   @default("IT")
  codiceDestinatario   String   @default("0000000")
  pecDestinatario      String?
  regimeFiscale        String   @default("RF01") // RF01 = Ordinario, RF19 = Forfettario
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices             Invoice[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Invoice {
  id                 String        @id @default(cuid())
  fiscalProfileId    String
  progressiveNumber  Int
  fiscalYear         Int
  customerName       String
  customerFiscalCode String?
  customerVatNumber  String?
  customerAddress    String?
  totalNet           Float         @default(0)
  totalVat           Float         @default(0)
  totalGross         Float         @default(0)
  vatRate            Float         @default(22)
  status             String        @default("bozza") // bozza | inviata | consegnata | rifiutata
  sdiIdentifier      String?
  pdfUrl             String?
  xmlContent         String?
  notes              String?
  issuedAt           DateTime      @default(now())
  fiscalProfile      FiscalProfile @relation(fields: [fiscalProfileId], references: [id], onDelete: Cascade)
  lines              InvoiceLine[]
  createdAt          DateTime      @default(now())
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  vatRate     Float   @default(22)
  totalNet    Float
  totalVat    Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ─── Cross-Promotion Network (Feature 8) ────────────────────────

model Partnership {
  id            String   @id @default(cuid())
  businessAId   String
  businessBId   String
  status        String   @default("pending") // pending | active | declined | ended
  type          String   @default("sconto_reciproco") // sconto_reciproco | punti_condivisi | evento_congiunto
  businessA     Business @relation("PartnerA", fields: [businessAId], references: [id], onDelete: Cascade)
  businessB     Business @relation("PartnerB", fields: [businessBId], references: [id], onDelete: Cascade)
  crossPromotions CrossPromotion[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessAId, businessBId])
}

model CrossPromotion {
  id              String      @id @default(cuid())
  partnershipId   String
  fromBusinessId  String
  toBusinessId    String
  discountPercent Int         @default(10)
  description     String
  active          Boolean     @default(true)
  expiresAt       DateTime?
  partnership     Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  fromBusiness    Business    @relation("PromoFrom", fields: [fromBusinessId], references: [id], onDelete: Cascade)
  toBusiness      Business    @relation("PromoTo", fields: [toBusinessId], references: [id], onDelete: Cascade)
  vouchers        Voucher[]
  createdAt       DateTime    @default(now())
}

model Voucher {
  id              String          @id @default(cuid())
  businessId      String
  crossPromotionId String?
  code            String          @unique
  discountPercent Int             @default(10)
  description     String
  customerPhone   String?
  redeemed        Boolean         @default(false)
  redeemedAt      DateTime?
  expiresAt       DateTime
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  crossPromotion  CrossPromotion? @relation(fields: [crossPromotionId], references: [id])
  createdAt       DateTime        @default(now())
}

// ─── PWA Push Notifications (Feature 9) ─────────────────────────

model PushSubscription {
  id           String   @id @default(cuid())
  businessId   String?
  endpoint     String   @unique
  p256dh       String
  auth         String
  userType     String   @default("owner") // owner | staff | customer
  userId       String?
  customerId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

// ─── Security: Rate Limiting (Feature 10) ───────────────────────

model RateLimit {
  id         String   @id @default(cuid())
  key        String   // e.g., "login:192.168.1.1" or "otp:+393331234567"
  attempts   Int      @default(1)
  windowStart DateTime @default(now())
  expiresAt  DateTime

  @@index([key])
}

// ─── Iter3 Feature 1: WhatsApp Conversational AI ────────────────

model ConversationState {
  id          String   @id @default(cuid())
  businessId  String
  phone       String
  context     String   @default("{}") // JSON: current intent, collected slots
  lastIntent  String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, phone])
}

// ─── Iter3 Feature 2: Product Catalog & Storefront ──────────────

model ProductCategory {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  sortOrder   Int       @default(0)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id          String           @id @default(cuid())
  businessId  String
  categoryId  String?
  name        String
  description String           @default("")
  priceEuro   Float
  imageUrl    String?
  stock       Int              @default(-1) // -1 = unlimited
  isAvailable Boolean          @default(true)
  sortOrder   Int              @default(0)
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Order {
  id             String      @id @default(cuid())
  businessId     String
  customerName   String
  customerPhone  String?
  customerEmail  String?
  status         String      @default("ricevuto") // ricevuto | in_preparazione | pronto | consegnato | cancellato
  channel        String      @default("online") // online | whatsapp
  totalEuro      Float       @default(0)
  paymentStatus  String      @default("pending") // pending | paid | refunded
  paymentIntentId String?
  notes          String?
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int     @default(1)
  unitPrice  Float
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
}

// ─── Iter3 Feature 3: Association White-Label Portal ────────────

model Association {
  id           String                  @id @default(cuid())
  name         String
  slug         String                  @unique
  type         String                  @default("CNA") // CNA | Confartigianato | Confcommercio
  city         String                  @default("Forlì")
  logoUrl      String?
  primaryColor String                  @default("#1E40AF")
  contactEmail String
  contactPhone String?
  website      String?
  memberships  AssociationMembership[]
  admins       AssociationAdmin[]
  subscription GroupSubscription?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
}

model AssociationMembership {
  id             String      @id @default(cuid())
  associationId  String
  businessId     String
  status         String      @default("active") // active | suspended | invited
  joinedAt       DateTime    @default(now())
  association    Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([associationId, businessId])
}

model AssociationAdmin {
  id             String      @id @default(cuid())
  associationId  String
  email          String
  name           String
  passwordHash   String
  role           String      @default("admin") // admin | viewer
  association    Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
}

model GroupSubscription {
  id              String      @id @default(cuid())
  associationId   String      @unique
  plan            String      @default("base") // base | premium
  pricePerMember  Float       @default(15)
  maxMembers      Int         @default(50)
  status          String      @default("active") // active | cancelled | past_due
  stripeSubId     String?
  association     Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ─── Iter3 Feature 4: Customer Payment Collection ───────────────

model PaymentTransaction {
  id              String   @id @default(cuid())
  businessId      String
  type            String   // deposit | full_payment | gift_card_purchase | gift_card_redemption
  amountEuro      Float
  currency        String   @default("EUR")
  status          String   @default("pending") // pending | completed | refunded | failed
  stripePaymentId String?
  customerName    String?
  customerPhone   String?
  bookingId       String?
  giftCardId      String?
  platformFee     Float    @default(0)
  netAmount       Float    @default(0)
  createdAt       DateTime @default(now())
}

model GiftCard {
  id              String   @id @default(cuid())
  businessId      String?  // null = "Bottega Credits" (cross-business)
  code            String   @unique
  amountEuro      Float
  balanceEuro     Float
  purchaserName   String?
  purchaserPhone  String?
  recipientName   String?
  recipientPhone  String?
  message         String?
  status          String   @default("active") // active | redeemed | expired
  expiresAt       DateTime
  business        Business? @relation(fields: [businessId], references: [id])
  createdAt       DateTime @default(now())
  redeemedAt      DateTime?
}

// ─── Iter3 Feature 6: Notification Center ───────────────────────

model Notification {
  id          String   @id @default(cuid())
  businessId  String
  type        String   // booking | payment | review | loyalty | queue | automation | system
  title       String
  body        String
  read        Boolean  @default(false)
  actionUrl   String?
  priority    String   @default("normal") // low | normal | urgent
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// ─── Iter3 Feature 7: Accountant Portal ─────────────────────────

model Accountant {
  id           String                @id @default(cuid())
  email        String                @unique
  name         String
  studio       String?
  passwordHash String
  referralCode String                @unique
  clients      AccountantClientLink[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model AccountantClientLink {
  id            String     @id @default(cuid())
  accountantId  String
  businessId    String
  inviteCode    String     @unique
  status        String     @default("pending") // pending | active | revoked
  accountant    Accountant @relation(fields: [accountantId], references: [id], onDelete: Cascade)
  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())

  @@unique([accountantId, businessId])
}

// ─── Iter3 Feature 8: i18n & Expansion Kit ──────────────────────

model TranslationOverride {
  id        String   @id @default(cuid())
  locale    String
  key       String
  value     String
  createdAt DateTime @default(now())

  @@unique([locale, key])
}

model RegionConfig {
  id             String @id @default(cuid())
  city           String @unique
  region         String
  defaultVatRate Float  @default(22)
  associations   String @default("[]") // JSON array of association names
  categories     String @default("[]") // JSON array of default business categories
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
}

// ─── Iter3 Feature 9: Marketplace ───────────────────────────────

model MarketplaceListing {
  id          String   @id @default(cuid())
  businessId  String
  type        String   @default("service") // service | product
  title       String
  description String
  priceEuro   Float?
  category    String
  imageUrl    String?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Iter3 Feature 10: Platform Analytics & Churn ───────────────

model PlatformEvent {
  id          String   @id @default(cuid())
  businessId  String?
  eventType   String   // page_view | feature_use | api_call | login | booking_created | payment_received
  metadata    String   @default("{}") // JSON
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([businessId, eventType])
  @@index([createdAt])
}

model BusinessHealthScore {
  id              String   @id @default(cuid())
  businessId      String   @unique
  score           Int      @default(100) // 0-100
  riskTier        String   @default("healthy") // healthy | at_risk | churning
  loginFrequency7d Int     @default(0)
  loginFrequency30d Int    @default(0)
  featureBreadth  Int      @default(0) // number of modules used
  bookingTrend    String   @default("stable") // growing | stable | declining
  lastCalculated  DateTime @default(now())
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Iter4 Feature 2: Media Pipeline ────────────────────────────

model MediaAsset {
  id          String   @id @default(cuid())
  businessId  String
  filename    String
  mimeType    String
  sizeBytes   Int
  url         String   // CDN URL
  thumbnailUrl String? // 200px variant
  mediumUrl   String?  // 600px variant
  width       Int?
  height      Int?
  alt         String?
  folder      String   @default("general") // general | products | social | logo | hero
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([businessId, folder])
}

// ─── Iter4 Feature 7: Webhook API & Developer Platform ──────────

model ApiKey {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  keyHash     String   @unique
  keyPrefix   String   // e.g., "sk_live_abc..."
  scopes      String   @default("read") // comma-separated: read,write,webhooks
  rateLimit   Int      @default(1000) // requests per hour
  lastUsedAt  DateTime?
  active      Boolean  @default(true)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebhookEndpoint {
  id          String   @id @default(cuid())
  businessId  String
  url         String
  events      String   @default("*") // comma-separated event types or * for all
  secret      String   // HMAC signing secret
  active      Boolean  @default(true)
  failCount   Int      @default(0)
  lastDeliveryAt DateTime?
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  endpointId  String
  event       String
  payload     String   // JSON
  responseCode Int?
  responseBody String?
  attempts    Int      @default(1)
  status      String   @default("pending") // pending | delivered | failed
  nextRetryAt DateTime?
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// ─── Iter4 Feature 10: GDPR Compliance ──────────────────────────

model CustomerConsent {
  id                String   @id @default(cuid())
  customerId        String
  businessId        String
  whatsappMarketing Boolean  @default(false)
  whatsappTransactional Boolean @default(true)
  emailMarketing    Boolean  @default(false)
  emailTransactional Boolean @default(true)
  pushNotifications Boolean  @default(true)
  analyticsTracking Boolean  @default(true)
  thirdPartySharing Boolean  @default(false)
  consentedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([customerId, businessId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorType   String   // owner | staff | accountant | association_admin | system | customer
  actorId     String
  action      String   // data_access | data_export | data_delete | consent_change | login
  resource    String   // customer | booking | invoice | payment
  resourceId  String?
  businessId  String?
  details     String   @default("{}") // JSON
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([businessId, action])
  @@index([actorId, actorType])
}

model DataExportRequest {
  id          String   @id @default(cuid())
  businessId  String?
  customerId  String?
  requestType String   // customer_data | business_data
  status      String   @default("pending") // pending | processing | completed | failed
  format      String   @default("json") // json | csv
  downloadUrl String?
  expiresAt   DateTime?
  requestedBy String   // actor ID
  createdAt   DateTime @default(now())
  completedAt DateTime?
}

// ─── Iter5 Feature 8: Email Delivery Tracking ───────────────────

model EmailDelivery {
  id          String   @id @default(cuid())
  businessId  String?
  template    String   // booking_confirmation | payment_receipt | etc.
  to          String
  subject     String
  status      String   @default("sent") // sent | delivered | bounced | opened | clicked
  messageId   String?  // Resend message ID
  locale      String   @default("it")
  openedAt    DateTime?
  clickedAt   DateTime?
  bouncedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([businessId, template])
  @@index([status])
}

model EmailTemplateOverride {
  id          String   @id @default(cuid())
  businessId  String
  template    String   // template key
  locale      String   @default("it")
  subject     String?  // custom subject override
  greeting    String?  // custom greeting text
  footer      String?  // custom footer text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, template, locale])
}

// ─── Iter5 Feature 9: Notification Preferences ──────────────────

model NotificationPreference {
  id                String   @id @default(cuid())
  customerId        String
  businessId        String
  preferredChannel  String   @default("email") // whatsapp | email | push
  quietHoursStart   String   @default("22:00") // HH:MM
  quietHoursEnd     String   @default("08:00") // HH:MM
  digestEnabled     Boolean  @default(false)
  digestTime        String   @default("09:00") // HH:MM
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([customerId, businessId])
}

model NotificationLog {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String?
  eventType   String   // booking.created | payment.received | etc.
  channel     String   // whatsapp | email | push | digest
  status      String   @default("sent") // sent | delivered | failed | suppressed | digested
  reason      String?  // suppression reason
  createdAt   DateTime @default(now())

  @@index([businessId, customerId])
  @@index([eventType, status])
}
