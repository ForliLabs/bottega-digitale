# ─── Database ────────────────────────────────────────────────────
# Local: file:prisma/dev.db
# Production: libsql://your-db.turso.io
DATABASE_URL="file:prisma/dev.db"
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ─── Stripe (Payments & Billing) ────────────────────────────────
STRIPE_SECRET_KEY=""
