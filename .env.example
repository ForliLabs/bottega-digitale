# ─── Webhook Signing ──────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=""

# ─── Application ──────────────────────────────────────────────
NEXT_PUBLIC_URL="http://localhost:3000"
NODE_ENV="development"
